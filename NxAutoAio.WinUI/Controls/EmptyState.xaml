<UserControl
    x:Class="NxAutoAio.WinUI.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Khối trạng thái rỗng gồm biểu tượng, tiêu đề và thông điệp được truyền từ code-behind. -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <FontIcon x:Name="StateIcon" Glyph="&#xE8A5;" FontSize="30" Opacity="0.55" HorizontalAlignment="Center" />
        <TextBlock x:Name="TitleText" FontSize="16" HorizontalAlignment="Center" />
        <TextBlock x:Name="MessageText" Opacity="0.65" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
