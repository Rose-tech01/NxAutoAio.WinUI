<UserControl
    x:Class="NxAutoAio.WinUI.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="4">
        <TextBlock x:Name="TitleText" FontSize="32" FontWeight="SemiBold" />
        <TextBlock x:Name="SubtitleText" Opacity="0.68" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
