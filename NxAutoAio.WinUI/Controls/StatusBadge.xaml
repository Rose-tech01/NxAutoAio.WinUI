<UserControl
    x:Class="NxAutoAio.WinUI.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nền huy hiệu được code-behind tô màu theo trạng thái; nội dung hiển thị ở giữa. -->
    <Border x:Name="Badge" CornerRadius="10" Padding="10,4">
        <TextBlock x:Name="StatusText" FontSize="12" />
    </Border>
</UserControl>
