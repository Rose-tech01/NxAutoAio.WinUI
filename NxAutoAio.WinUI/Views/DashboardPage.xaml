<Page
    x:Class="NxAutoAio.WinUI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32">
            <TextBlock Text="Dashboard tổng quan" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Theo dõi nhanh tình trạng xử lý hàng hóa và các dịch vụ logistics."
                       Opacity="0.68"
                       Margin="0,0,0,24" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <FontIcon Glyph="&#xE8B0;" FontSize="20" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="MAWB hôm nay" Margin="0,14,0,2" Opacity="0.72" />
                        <TextBlock Text="128" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="+12% so với hôm qua" FontSize="12" Opacity="0.68" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <FontIcon Glyph="&#xE8A7;" FontSize="20" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="HAWB hôm nay" Margin="0,14,0,2" Opacity="0.72" />
                        <TextBlock Text="486" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Trung bình 3.8 HAWB/MAWB" FontSize="12" Opacity="0.68" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <FontIcon Glyph="&#xE916;" FontSize="20" Foreground="#D99A00" />
                        <TextBlock Text="Đang chờ xử lý" Margin="0,14,0,2" Opacity="0.72" />
                        <TextBlock Text="24" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Cần được kiểm tra" FontSize="12" Opacity="0.68" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <FontIcon Glyph="&#xE73E;" FontSize="20" Foreground="#D13438" />
                        <TextBlock Text="Lỗi cần xử lý" Margin="0,14,0,2" Opacity="0.72" />
                        <TextBlock Text="5" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="2 lỗi mức độ cao" FontSize="12" Opacity="0.68" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Lô hàng cần xử lý" Style="{StaticResource SectionTitleStyle}" />
                        <Grid ColumnSpacing="12" Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MAWB" Opacity="0.65" />
                            <TextBlock Text="Trạng thái" Grid.Column="1" Opacity="0.65" />
                            <TextBlock Text="Cập nhật" Grid.Column="2" Opacity="0.65" />
                        </Grid>
                        <Grid ColumnSpacing="12" Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="738-12345678" />
                            <TextBlock Text="Chờ tra thông quan" Grid.Column="1" Foreground="#D99A00" />
                            <TextBlock Text="2 phút trước" Grid.Column="2" Opacity="0.68" />
                        </Grid>
                        <Grid ColumnSpacing="12" Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="738-12345679" />
                            <TextBlock Text="Thiếu dữ liệu HAWB" Grid.Column="1" Foreground="#D13438" />
                            <TextBlock Text="8 phút trước" Grid.Column="2" Opacity="0.68" />
                        </Grid>
                        <Grid ColumnSpacing="12" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="738-12345680" />
                            <TextBlock Text="Đã thông quan" Grid.Column="1" Foreground="#107C10" />
                            <TextBlock Text="15 phút trước" Grid.Column="2" Opacity="0.68" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Tổng quan tiến trình" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Đã thông quan" Margin="0,8,0,4" />
                        <ProgressBar Value="76" Height="6" />
                        <TextBlock Text="97 / 128 MAWB" FontSize="12" Opacity="0.68" Margin="0,4,0,12" />
                        <TextBlock Text="Đã in tờ khai" Margin="0,4,0,4" />
                        <ProgressBar Value="61" Height="6" />
                        <TextBlock Text="78 / 128 MAWB" FontSize="12" Opacity="0.68" Margin="0,4,0,12" />
                        <TextBlock Text="Đồng bộ AS400 gần nhất: 10:28:42" FontSize="12" Opacity="0.68" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
