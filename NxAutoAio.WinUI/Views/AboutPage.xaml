<Page
    x:Class="NxAutoAio.WinUI.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16">
            <!-- Thông tin nhận diện ứng dụng, phiên bản, tác giả và mô tả sản phẩm. -->
            <TextBlock Text="Thông tin tác giả" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Thông tin về ứng dụng và phiên bản phát hành" Opacity="0.68" />
            <Border Style="{StaticResource CardStyle}">
                <Grid RowSpacing="14" ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Tên phần mềm:" />
                    <TextBlock Text="NX Auto AIO" Grid.Column="1" Opacity="0.75" />
                    <TextBlock Text="Phiên bản:" Grid.Row="1" />
                    <TextBlock Text="v1.8.2 - GUI Release Edition" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Tác giả:" Grid.Row="2" />
                    <TextBlock Text="Lưu Thanh Tú" Grid.Row="2" Grid.Column="1" Foreground="#FFFFB86C" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Mô tả ứng dụng" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="NX Auto AIO là giải pháp phần mềm chuyên dụng được thiết kế nhằm tự động hóa quy trình xử lý chứng từ hàng hóa trong lĩnh vực Logistics hàng không. Phần mềm hỗ trợ quản lý, sắp xếp và tối ưu hóa quy trình in ấn tờ khai, dữ liệu và tờ cần một cách nhanh chóng, chính xác." />
                </StackPanel>
            </Border>
            <TextBlock Text="Copyright (c) 2026 Lưu Thanh Tú. All rights reserved."
                       Opacity="0.6" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
