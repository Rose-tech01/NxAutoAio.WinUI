<Page
    x:Class="NxAutoAio.WinUI.Views.DeclarationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="PageRoot" Padding="32" SizeChanged="PageRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="In Tờ Khai" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Tìm kiếm, kiểm tra và xử lý tài liệu logistics hàng ngày."
                       Opacity="0.68" Margin="0,0,0,20" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16">
            <Grid ColumnSpacing="10" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ChooseFolderButton" Content="Chọn thư mục" Style="{StaticResource ToolbarButtonStyle}" Click="ChooseFolder_Click" />
                <TextBlock x:Name="FolderStatus" Grid.Column="1" VerticalAlignment="Center"
                           Text="Chưa chọn thư mục" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Chưa chọn thư mục" />
                <Button Grid.Column="2" Content="Mở thư mục" Style="{StaticResource ToolbarButtonStyle}" Click="OpenFolder_Click" />
                <Button Grid.Column="3" Content="Quét lại" Style="{StaticResource ToolbarButtonStyle}" Click="Refresh_Click" />
            </Grid>
        </Border>

        <Grid x:Name="FilterGrid" Grid.Row="2" ColumnSpacing="10" RowSpacing="8" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Tìm theo tên file, MAWB hoặc HAWB..."
                     TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="StatusFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="StatusFilter_SelectionChanged">
                <ComboBoxItem Content="Tất cả trạng thái" Tag="All" />
                <ComboBoxItem Content="Chưa xử lý" Tag="Chưa xử lý" />
                <ComboBoxItem Content="Đã in" Tag="Đã in" />
                <ComboBoxItem Content="Đang xử lý" Tag="Đang xử lý" />
                <ComboBoxItem Content="Thiếu mã vạch" Tag="Thiếu mã vạch" />
                <ComboBoxItem Content="Lỗi" Tag="Lỗi" />
            </ComboBox>
            <TextBlock x:Name="ResultStatus" Grid.Column="2" Width="125" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Opacity="0.7" />
        </Grid>

        <Grid x:Name="ContentGrid" Grid.Row="3" ColumnSpacing="16" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Border x:Name="DocumentCard" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Background="{StaticResource SubtleCardBrush}" Padding="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Chọn tất cả" Style="{StaticResource ToolbarButtonStyle}" Click="SelectAll_Click" />
                            <Button Content="Bỏ chọn" Style="{StaticResource ToolbarButtonStyle}" Click="ClearSelection_Click" />
                            <TextBlock Text="Danh sách tờ khai" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel MinWidth="900">
                            <Grid Padding="12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" /><ColumnDefinition Width="220" /><ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" /><ColumnDefinition Width="75" /><ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="100" /><ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Chọn" /><TextBlock Text="Tên file" Grid.Column="1" />
                                <TextBlock Text="MAWB" Grid.Column="2" /><TextBlock Text="HAWB" Grid.Column="3" />
                                <TextBlock Text="Trang" Grid.Column="4" /><TextBlock Text="Mã vạch" Grid.Column="5" />
                                <TextBlock Text="Trạng thái" Grid.Column="6" /><TextBlock Text="Cập nhật" Grid.Column="7" />
                            </Grid>
                            <ListView x:Name="DocumentList"
                                      SelectionMode="None"
                                      HorizontalContentAlignment="Stretch">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,8" MinHeight="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" /><ColumnDefinition Width="220" /><ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="140" /><ColumnDefinition Width="75" /><ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="100" /><ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding FileName}" Grid.Column="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding FileName}" />
                                            <TextBlock Text="{Binding Mawb}" Grid.Column="2" />
                                            <TextBlock Text="{Binding Hawb}" Grid.Column="3" />
                                            <TextBlock Text="{Binding PageCount}" Grid.Column="4" />
                                            <TextBlock Text="{Binding BarcodeStatus}" Grid.Column="5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PrintStatus}" Grid.Column="6" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding LastUpdated}" Grid.Column="7" Opacity="0.7" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Padding="32" Spacing="8">
                                <FontIcon Glyph="&#xE8A5;" FontSize="28" Opacity="0.55" />
                                <TextBlock Text="Không tìm thấy tài liệu" FontSize="16" />
                                <TextBlock Text="Thử thay đổi từ khóa hoặc bộ lọc." Opacity="0.65" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border x:Name="OptionsCard" Grid.Column="1" Style="{StaticResource CardStyle}"
                    VerticalAlignment="Top" MinHeight="360">
                <StackPanel Spacing="12">
                    <TextBlock Text="Tùy chọn in" Style="{StaticResource SectionTitleStyle}" />
                    <ComboBox Header="Máy in đích" SelectedIndex="0">
                        <ComboBoxItem Content="Microsoft Print to PDF" />
                        <ComboBoxItem Content="Default Printer" />
                    </ComboBox>
                    <TextBlock Text="Trạng thái: Sẵn sàng" Foreground="#107C10" FontSize="12" />
                    <RadioButtons Header="Định dạng">
                        <RadioButton Content="Excel" IsChecked="True" />
                        <RadioButton Content="PDF" />
                    </RadioButtons>
                    <RadioButtons Header="Phạm vi trang">
                        <RadioButton Content="In toàn bộ tài liệu" IsChecked="True" />
                        <RadioButton Content="In theo dải trang" />
                    </RadioButtons>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox Header="Từ" Value="1" Minimum="1" Width="110" />
                        <NumberBox Header="Đến" Value="1" Minimum="1" Width="110" />
                    </StackPanel>
                    <CheckBox Content="Bỏ qua lấy mã vạch" />
                    <CheckBox Content="Chỉ in file hợp lệ" IsChecked="True" />
                    <CheckBox Content="Bỏ qua file đã in" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="16" Margin="0,12,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton" Content="Bắt đầu in đã chọn" Style="{StaticResource ToolbarButtonStyle}" Click="StartPrint_Click" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="StatusText" Text="Sẵn sàng" />
                    <ProgressBar x:Name="PrintProgress" Minimum="0" Maximum="100" Value="0" />
                </StackPanel>
                <TextBlock x:Name="SummaryText" Grid.Column="2" Text="Đã chọn: 0" VerticalAlignment="Center" />
                <TextBlock x:Name="SuccessText" Grid.Column="3" Text="Thành công: 0" VerticalAlignment="Center" Foreground="#107C10" />
                <TextBlock x:Name="ErrorText" Grid.Column="4" Text="Lỗi: 0" VerticalAlignment="Center" Foreground="#D13438" />
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>
